PORT=3100
# Spec 11.7: this app no longer talks to the e-paper hub. It asks core-api to update a
# table and core-api calls the SDK, so EPAPER_HUB_URL and EPAPER_API_KEY have moved to
# apps/core-api/.env.example. These two replace them.
# Docker: http://core-api:3200
CORE_API_URL=http://core-api:3200
# The interim shared service token (spec 11.9), presented to core-api as
# `Authorization: Bearer <token>` and compared there with crypto.timingSafeEqual. It must
# be byte-identical to core-api's TABLE_DISPLAY_SERVICE_TOKEN and at least 32 characters --
# core-api refuses to listen with a shorter one. Superseded by terminal pairing in Phase 3.
TABLE_DISPLAY_SERVICE_TOKEN=replace-with-a-32-plus-character-random-secret
ORDER_BASE_URL=https://order.yeyintlwin.com
SHOP_ID=1
CHECKOUT_API_KEY=replace-with-independent-random-secret
BUSINESS_TIME_ZONE=Asia/Tokyo
BUSINESS_DAY_ROLLOVER_HOUR=6
# The bearer for this app's own POST /api/table-displays/{n}/welcome provisioning route.
# Unrelated to the two above: that route is inbound, these are outbound.
TABLE_DISPLAY_API_KEY=replace-with-a-separate-long-random-secret
